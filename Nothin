local function runRemote(remote,payload)
    if typeof(remote)~="Instance" then warn("[Executor] invalid remote") return false end
    if type(payload)~="string" then warn("[Executor] payload must be string") return false end
    local ok,err=pcall(function()
        if remote:IsA("RemoteEvent") then remote:FireServer(payload)
        elseif remote:IsA("RemoteFunction") then remote:InvokeServer(payload)
        else error("not a remote") end
    end)
    if not ok then warn("[Executor] "..tostring(err)) return false end
    return true
end

local function findRemote()
    for _,n in ipairs({"Backdoor","Remote","Execute","Executor","RunCode","Loadstring","Command","Cmd","Re","SendScript"}) do
        local f=RSS:FindFirstChild(n,true)
        if f and (f:IsA("RemoteEvent")or f:IsA("RemoteFunction")) then return f end
    end
    return nil
end


local function runScript(n)
    local s=n:lower()
    local m={
        {"jumpscare",":jumpscare all"},{"kill all",":kill all"},{"explode all",":explode all"},
        {"freeze all",":freeze all"},{"unfreeze all",":unfreeze all"},{"destroy",":destroy all"},
        {"btools",":btools"},{"f3x",":f3x"},{"grab knife",":grab knife"},{"fire axe",":fire axe"},
        {"sword",":sword"},{"nuke",":nuke"},{"god",":god me"},{"ungod",":ungod me"},
        {"speed",":speed me 100"},{"jump",":jump me 100"},{"kick all",":kick all"},
        {"lag",":lag all"},{"hide",":hide me"},{"show",":show me"},{"freeze",":freeze me"},
        {"unfreeze",":unfreeze me"},{"remove backpack",":removebackpack me"},{"delete playergui",":cleargui me"}
    }
    for _,p in ipairs(m) do if s:find(p[1]) then cmd(p[2]);return end end
    cmd(":"..s:gsub("%s+",""))
end


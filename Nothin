local function hasF3X()
    local lp=PL.LocalPlayer;if not lp then return false end
    local function scan(c)
        if not c then return false end
        for _,v in ipairs(c:GetChildren()) do
            if v:IsA("Tool") then
                local n=v.Name:lower()
                if n:find("f3x")or n:find("fork3v")or n:find("building")or v:FindFirstChild("SyncAPI")then return true end
            end
        end
        return false
    end
    return scan(lp.Character)or scan(lp:FindFirstChildOfClass("Backpack"))or scan(lp)
end

local function hasHD()
    local lp=PL.LocalPlayer;if not lp then return false end
    if not workspace:FindFirstChild("HDAdminWorkspaceFolder")then return false end
    local ok,ad=pcall(function()
        local cl=RSS:FindFirstChild("HDAdminHDClient");if not cl then return false end
        local m=cl:FindFirstChild("Modules");if not m then return false end
        for _,x in ipairs(m:GetChildren()) do
            if x:IsA("ModuleScript")and(x.Name:lower():find("permission")or x.Name:lower():find("rank"))then
                local mod=require(x)
                if type(mod)=="table"and mod.GetRank then return mod.GetRank(lp)and true or false end
            end
        end
        return false
    end)
    if ok and ad then return true end
    local ls=lp:FindFirstChild("leaderstats")
    if ls then
        for _,v in ipairs(ls:GetChildren()) do
            if v.Name:lower():find("rank")or v.Name:lower():find("admin")then
                local s=tostring(v.Value):lower()
                if s:find("admin")or s:find("owner")or s:find("mod")or s:find("hd")or s:find("staff")then return true end
            end
        end
    end
    return false
end

